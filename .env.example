# Copie este arquivo para .env.local e preencha. O .env.local NÃO vai para o GitHub.
# Nunca coloque o certificado dentro desta pasta e nunca cole a senha em chat.
SEFAZ_CERT_PATH=C:\certificado\NOME-DO-ARQUIVO.pfx
SEFAZ_CERT_SENHA=
SEFAZ_CNPJ=00000000000000

# Opcionais (os valores abaixo já são o padrão):
# SEFAZ_UF_AUTOR=35        (código da UF do CNPJ; 35 = SP)
# SEFAZ_AMBIENTE=1         (1 = produção, 2 = homologação)
# SEFAZ_MAX_LOTES=1        (máximo 3 por execução)
# SEFAZ_URL=               (endereço do serviço, se mudar no portal da NF-e)
# SEFAZ_CA_PATH=           (arquivo .pem com as raízes ICP-Brasil, só se o Node não confiar)
